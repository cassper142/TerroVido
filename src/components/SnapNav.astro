---
import type { Locale, Dictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { t } = Astro.props as Props;

const anchors = ['#hero', '#products', '#why', '#about', '#network', '#blog', '#contact'] as const;
const items = t.snapNav.sections.map((label, i) => ({
  label,
  anchor: anchors[i],
}));
---

<aside class="snap-nav" aria-label="Section navigation">
  <button
    type="button"
    class="snap-nav-btn"
    data-snap-action="prev"
    aria-label={t.snapNav.prev}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  <nav class="snap-dots" aria-label="Section dots">
    {items.map((item, i) => (
      <button
        type="button"
        class="snap-dot"
        data-snap-dot={i}
        data-snap-anchor={item.anchor}
        aria-label={`${t.snapNav.goTo} ${item.label}`}
        aria-current={i === 0 ? 'true' : undefined}
      ></button>
    ))}
  </nav>

  <button
    type="button"
    class="snap-nav-btn"
    data-snap-action="next"
    aria-label={t.snapNav.next}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</aside>
