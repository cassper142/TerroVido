---
import type { Locale, Dictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { t } = Astro.props as Props;

const icons = [
  '/images/mugs2u5d-muj8bur.svg',
  '/images/mugs2u5d-kagqx5q.svg',
  '/images/mugs2u5d-1rzy0n5.svg',
] as const;

const features = t.why.items.map((f, i) => ({
  ...f,
  icon: icons[i],
}));
---

<section class="snap-section bg-surface-muted py-[100px]" id="why">
  <div class="container">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 mb-[60px]">
      <div class="flex flex-col gap-4 max-w-[712px] w-full" data-stagger="110">
        <div class="section-label" data-animate="fade-up">
          <span>{t.why.label}</span>
        </div>
        <h2 class="section-title" data-animate="fade-up">
          {t.why.title}
        </h2>
      </div>
      <p class="section-text max-w-[407px]" data-animate="fade-up">
        {t.why.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger="140">
      {features.map((f) => (
        <article class="flex flex-col gap-3 bg-surface rounded-[10px] p-5 shadow-sm transition-all duration-300 hover:shadow-card hover:-translate-y-1" data-animate="fade-up">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center justify-center w-[54px] h-[54px] rounded-full bg-gold-light" data-animate="pop-in">
              <img
                src={f.icon}
                alt=""
                class="w-7 h-7"
                width="28"
                height="28"
              />
            </div>
            <span class="text-ink-gray text-[26px] font-sans" data-animate="fade-in">{f.num}</span>
          </div>
          <h3 class="font-bold text-gold text-[28px] leading-[37px] md:text-[36px]">
            {f.title}
          </h3>
          <p class="section-text">{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
